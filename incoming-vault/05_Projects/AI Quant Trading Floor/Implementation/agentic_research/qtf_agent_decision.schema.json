{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QTF Agent Decision Object",
  "type": "object",
  "required": ["schema_version", "run_id", "asset_or_pair", "stage", "provenance", "hypotheses", "invalidation", "risk", "paper_only", "next_evidence_step"],
  "properties": {
    "schema_version": {"const": "qtf-agent-decision-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "asset_or_pair": {"type": "string", "minLength": 1},
    "stage": {"enum": ["perception", "reasoning", "strategy", "defi_monitor", "review"]},
    "provenance": {"type": "array", "items": {"type": "object", "required": ["source", "observed_at"], "properties": {"source": {"type": "string"}, "observed_at": {"type": "string"}, "field_coverage": {"type": "string"}}}},
    "hypotheses": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["label", "claim", "supporting_evidence", "contradicting_evidence", "confirmation_or_refutation"], "properties": {"label": {"enum": ["bullish", "bearish", "neither"]}, "claim": {"type": "string"}, "supporting_evidence": {"type": "array", "items": {"type": "string"}}, "contradicting_evidence": {"type": "array", "items": {"type": "string"}}, "confirmation_or_refutation": {"type": "string"}}}},
    "invalidation": {"type": "array", "items": {"type": "string"}},
    "risk": {"type": "object", "required": ["flag", "notes"], "properties": {"flag": {"enum": ["green", "amber", "red"]}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "paper_only": {"const": true},
    "next_evidence_step": {"type": "string", "minLength": 1},
    "proposal": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
