# Local/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Obsidian per-machine state — the shared config in .obsidian/ IS committed,
# but workspace layout, caches and plugin data are local.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/graph-cache.json
.obsidian/plugins/
.trash/

# Private source material — keep raw files out of a public repo.
sources/private/

# Generated galaxy output. Rebuild with: python3 tools/build_graph.py
tools/galaxy/*.html
tools/galaxy/*.json
!tools/galaxy/template.html

# Temporary conversion outputs
*.tmp
*.bak
__pycache__/
*.pyc

# Imported vault: build artefacts and sync metadata, not knowledge
incoming-vault/**/.venv/
incoming-vault/**/node_modules/
incoming-vault/**/__pycache__/
incoming-vault/**/.pytest_cache/
incoming-vault/**/.mypy_cache/
incoming-vault/**/.ruff_cache/
incoming-vault/**/*.pyc
incoming-vault/.stfolder/
incoming-vault/.stversions/
