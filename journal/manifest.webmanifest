{
  "name": "Daybook — journal, to-dos & voice notes",
  "short_name": "Daybook",
  "description": "Journal, to-dos, schedule and voice notes in one place, synced with Google Calendar.",
  "start_url": "./#/day",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f1e7",
  "theme_color": "#f6f1e7",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Record voice note", "url": "./?action=record#/day", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "To-do list", "url": "./#/tasks", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
